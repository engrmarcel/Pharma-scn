APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharma_network
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Used by `php artisan schema:export-sql` (XAMPP: C:/xampp/mysql/bin/mysqldump.exe)
MYSQLDUMP_PATH=mysqldump

# Account security (both OFF by default; can also be switched at runtime via PUT /api/v1/admin/security-settings)
# SECURITY_MFA_MODE: off | optional | required_for_platform_staff | required_for_all
SECURITY_MFA_MODE=off
SECURITY_EMAIL_VERIFICATION_REQUIRED=false

# Field force (ADR-0010)
FIELD_FORCE_VERIFICATION_RADIUS_M=200
FIELD_FORCE_MAX_ACCURACY_M=100
FIELD_FORCE_MAX_CLOCK_SKEW_MINUTES=10
FIELD_FORCE_MAX_OFFLINE_AGE_DAYS=30
FIELD_FORCE_LOCATION_RETENTION_DAYS=365

# Analytics (ADR-0018): optional read replica for dashboards (a connection name in config/database.php)
ANALYTICS_DB_CONNECTION=
# ANALYTICS_DB_HOST=

# Reporting assistant (ADR-0020): external planning is off unless set here AND consented to by the organization
ANALYTICS_AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANALYTICS_AI_MODEL=claude-opus-5-5

# Regions (ADR-0023): this deployment's region; enforce to refuse organizations hosted elsewhere
PLATFORM_REGION=default
PLATFORM_REGION_ENFORCE=false
# PLATFORM_REGION_URLS="africa-west=https://ng.example.com,africa-east=https://ke.example.com"
# Business dates: leave unset (each organization's time zone); tests set UTC
# BUSINESS_TIMEZONE=

# Offline sync (ADR-0011)
SYNC_MAX_BATCH=50
SYNC_DEVICE_TOKEN_TTL_HOURS=72
SYNC_MAX_PROCESSING_ATTEMPTS=5

# Scale and load testing (Phase 10, ADR-0025)
# Per-user API rate without an organization or plan entitlement; ceiling for "unlimited" plans
API_DEFAULT_RATE_PER_MINUTE=120
API_UNLIMITED_RATE_CEILING=6000
# Dashboards are kept this long per viewer (0 = always recompute)
ANALYTICS_DASHBOARD_CACHE_SECONDS=60
# Per-request profiling for load tests only (storage/logs/perf.jsonl); never in production
PERF_PROFILE=false

# Operational monitoring (Phase 10b): queues to watch, and the bearer token for GET /api/v1/metrics (empty = endpoint off)
OPS_MONITORED_QUEUES=default
OPS_METRICS_TOKEN=

# Logical backups and restore drills (Phase 10c, docs/DISASTER_RECOVERY.md)
BACKUP_ENABLED=false
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
# MYSQLDUMP_PATH=mysqldump
# MYSQL_CLIENT_PATH=mysql
